# Optional development settings. Copy to .env (gitignored) and a freshly flashed
# device uses these instead of asking through its setup portal. Any line can be
# left out. Release builds never include them.
WIFI_SSID=your-network-name
WIFI_PASS=your-network-password
CALENDAR_URL=https://script.google.com/macros/s/XXXX/exec?token=XXXX
# Weather location (defaults to London)
# WEATHER_LAT=51.5074
# WEATHER_LON=-0.1278
